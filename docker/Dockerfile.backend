# Backend image for ModelHunter
# CPU-only by default. For CUDA GPU support build with a PyTorch index URL:
#   docker build -f docker/Dockerfile.backend --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124 .
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}
ARG TORCH_INDEX_URL=

WORKDIR /app

# Install core deps first for layer caching.
# When TORCH_INDEX_URL is set (CUDA build), reinstall torch/torchvision from
# the PyTorch index so the image gets the CUDA-enabled wheels.
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ -n "$TORCH_INDEX_URL" ]; then \
         pip install --no-cache-dir --index-url "$TORCH_INDEX_URL" --force-reinstall torch torchvision; \
       fi

# Copy backend source and top-level dirs the backend needs at runtime
COPY backend/ backend/
COPY datasets/ datasets/
COPY pretrained_models/ pretrained_models/
COPY reports/ reports/
COPY results/ results/
COPY .env.example .env

ENV PYTHONPATH=/app/backend
# Reduces CUDA fragmentation for long-running adversarial ML jobs.
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
WORKDIR /app/backend

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
